# Anthropic API key with Managed Agents access
ANTHROPIC_API_KEY=

# From claude-lock.json after `ant apply`
TWYST_AGENT_ID=agent_...
TWYST_ENVIRONMENT_ID=env_...

# Optional
# Pin a version of the agent (the "version" in claude-lock.json). Empty = latest, so `ant apply` takes effect at once.
TWYST_AGENT_VERSION=
PORT=3000
# Spend cap per visitor conversation, in US cents ("100" = $1.00)
SESSION_BUDGET_CENTS=100
# Workspace slug for the Console session links in the log
ANTHROPIC_WORKSPACE=default
# Behind a reverse proxy: the header that carries the visitor's IP, for rate limiting.
# Use only a header the proxy overwrites on every request (fly.toml sets fly-client-ip). Leave empty when running directly.
CLIENT_IP_HEADER=
